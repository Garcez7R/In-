{
  "name": "inplus-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf:login": "wrangler login",
    "cf:d1:create": "wrangler d1 create inplus-db",
    "cf:d1:migrate:local": "wrangler d1 migrations apply inplus-db --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply inplus-db --remote",
    "cf:deploy": "wrangler pages deploy dist --project-name inplus"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "wrangler": "^4.127.0"
  }
}
